{
  "name": "cmmg-calendar-analyzer",
  "private": true,
  "version": "0.1.0",
  "description": "Analise QuadroHorarioAluno.json e exporte para Google Calendar (CSV) e Thunderbird (ICS).",
  "homepage": ".",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test 'src/lib/*.test.ts'",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fullcalendar/core": "^7.0.2",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/react": "^7.0.2",
    "@fullcalendar/timegrid": "^6.1.21",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "allowScripts": ["vite", "esbuild", "@esbuild/*", "@fullcalendar/*", "lucide-react", "clsx", "react", "react-dom", "react-router-dom", "typescript", "typescript-eslint", "eslint", "globals"]
}
