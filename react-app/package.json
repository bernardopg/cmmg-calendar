{
  "name": "cmmg-calendar-analyzer",
  "private": true,
  "version": "0.1.0",
  "description": "Analise QuadroHorarioAluno.json e exporte para Google Calendar (CSV) e Thunderbird (ICS).",
  "homepage": ".",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "overrides": {
    "browserslist": "^4.28.7",
    "@humanfs/node": "^0.16.8"
  },
  "packageManager": "npm@11.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test 'src/lib/*.test.ts'",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  },
  "allowScripts": ["vite", "esbuild", "@esbuild/*", "@fullcalendar/*", "lucide-react", "clsx", "react", "react-dom", "react-router-dom", "typescript", "typescript-eslint", "eslint", "globals"]
}
