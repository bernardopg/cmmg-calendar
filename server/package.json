{
  "name": "cmmg-calendar-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "cli:analyze": "tsx src/cli/analyzeSchedule.ts",
    "cli:export": "tsx src/cli/exportSchedule.ts",
    "cli:fetch": "tsx src/cli/fetchTotvsSchedule.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fetch-cookie": "^3.2.0",
    "tough-cookie": "^6.0.2",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": ["tsx", "esbuild", "@esbuild/*", "fastify", "@fastify/*", "dotenv", "zod", "undici", "fetch-cookie", "tough-cookie"]
}
