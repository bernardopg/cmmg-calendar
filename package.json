{
  "name": "cmmg-calendar",
  "private": true,
  "version": "0.3.0",
  "description": "SPA que converte o quadro de horários do TOTVS para Google Calendar e Thunderbird. Hospedado em calendar.scalpel.com.br.",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --prefix react-app",
    "install:all": "npm install --prefix react-app",
    "postinstall": "npm run install:all",
    "lint": "npm run lint --prefix react-app",
    "test": "npm run test --prefix react-app",
    "build": "npm run build --prefix react-app",
    "check": "npm run lint && npm run test && npm run build"
  },
  "overrides": {
    "undici": "^7.24.4",
    "esbuild": "^0.28.1",
    "ws": "^8.21.0"
  }
}
